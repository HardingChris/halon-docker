{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "generator": {
      "type": "object",
      "required": ["replicas", "sessions", "messagesPerBatch", "payloadBytes", "recipientsPerMessage", "domains", "delaySeconds", "batchTimeoutSeconds", "reuseConnection"],
      "properties": {
        "replicas": {"type": "integer", "minimum": 0},
        "sessions": {"type": "integer", "minimum": 1},
        "messagesPerBatch": {"type": "integer", "minimum": 1},
        "payloadBytes": {"type": "integer", "minimum": 1},
        "recipientsPerMessage": {"type": "integer", "minimum": 1},
        "reuseConnection": {"type": "boolean"},
        "delaySeconds": {"type": "integer", "minimum": 0},
        "batchTimeoutSeconds": {"type": "integer", "minimum": 1},
        "runSeconds": {"type": "integer", "minimum": 1},
        "domains": {
          "type": "array", "minItems": 1,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*\\.invalid$"}
        }
      }
    },
    "sink": {
      "type": "object",
      "properties": {
        "replicas": {"type": "integer", "minimum": 1},
        "maxConnections": {"type": "integer", "minimum": 1},
        "backlog": {"type": "integer", "minimum": 1}
      }
    }
  }
}